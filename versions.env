# What the PUBLISHED images bake and how they are tagged.
#
# This is not consumer configuration. A project using these images sets its
# Zephyr/SDK choice in devcontainer.json's containerEnv, and the devel image
# fetches whatever it asks for at runtime -- so a consumer is free to pin a
# different Zephyr than the one below without touching this repo.
#
# These values drive two things only:
#   * Dockerfile.ci, which BAKES a Zephyr + SDK for GitHub Actions containers
#     (a hosted runner has no persistent volume, so it cannot fetch at runtime)
#   * the image tag, z<zephyr>-sdk<sdk>
#
# Sourced by build.sh and .github/workflows/publish-images.yml.

ZEPHYR_VERSION=v4.4.0
ZSDK_VERSION=1.0.1

# Baked into the ci image, so this must be the UNION of what every consuming
# project builds for -- a hosted runner cannot add a toolchain at runtime.
# arm: nrf5340dk, nucleo_g474re. x86_64: native_sim/native/64. xtensa: esp32(s3).
ZSDK_TOOLCHAINS="arm-zephyr-eabi x86_64-zephyr-elf xtensa-espressif_esp32_zephyr-elf xtensa-espressif_esp32s3_zephyr-elf"

# Modules whose binary blobs are not in git; a fresh workspace has none.
ZEPHYR_BLOBS="hal_espressif"
