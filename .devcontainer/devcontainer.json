{
  "name": "Zephyr devcontainer (build from source)",
  // For working ON the images. Consuming projects pull the published devel image
  // instead and carry only their own devcontainer.json.
  //
  // Builds base + devel locally. Dockerfile.ci is skipped: it is ~14 GB and only
  // GitHub Actions consumes it. To test it, run `WITH_CI=1 bash build.sh`.
  //
  // Spelled out inline rather than calling build.sh, because on Windows `bash`
  // usually resolves to the WSL shim and the container never starts if WSL is
  // broken. Keep in step with build.sh and publish-images.yml.
  "image": "zephyr-devcontainer-devel:local",
  "initializeCommand": "docker build -f Dockerfile.base -t zephyr-devcontainer-base:local . && docker build -f Dockerfile.devel --build-arg BASE_IMAGE=zephyr-devcontainer-base:local -t zephyr-devcontainer-devel:local .",

  // The same config a consumer supplies. Kept here so the image can be smoke
  // tested end to end from this repo.
  "containerEnv": {
    "RUNNER_ALLOW_RUNASROOT": "1",
    "ZEPHYR_BASE": "/workdir/zephyr-sdks/v4.4.2/zephyr",
    "ZEPHYR_SDK_INSTALL_DIR": "/workdir/zephyr-sdks/toolchains/zephyr-sdk-1.0.1",
    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
    "ZSDK_TOOLCHAINS": "arm-zephyr-eabi x86_64-zephyr-elf xtensa-espressif_esp32_zephyr-elf xtensa-espressif_esp32s3_zephyr-elf",
    "ZEPHYR_BLOBS": "hal_espressif"
  },
  "containerUser": "root",
  "remoteUser": "root",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--privileged"
  ],
  // Same shared volumes as consumers, so a test here warms the same cache.
  "mounts": [
    "source=zephyr-sdks-cache,target=/workdir/zephyr-sdks,type=volume",
    "source=ncs-sdks-cache,target=/workdir/ncs-sdks,type=volume",
    "source=/dev,target=/dev,type=bind,bind-propagation=rslave"
  ],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postStartCommand": "/opt/devcontainer/setup-sdks.sh"
}
