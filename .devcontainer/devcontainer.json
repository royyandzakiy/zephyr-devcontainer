{
  "name": "Zephyr devcontainer (build from source)",

  // For working ON the images. Consuming projects pull the published devel
  // image instead. Dockerfile.ci is skipped here (~14 GB, CI only) -- test it
  // with `WITH_CI=1 bash build.sh`.
  //
  // Inlined rather than calling build.sh: on Windows `bash` usually resolves to
  // the WSL shim. Keep in step with build.sh and publish-images.yml.
  "image": "zephyr-devcontainer-devel:local",
  "initializeCommand": "docker build -f Dockerfile.base -t zephyr-devcontainer-base:local . && docker build -f Dockerfile.devel --build-arg BASE_IMAGE=zephyr-devcontainer-base:local -t zephyr-devcontainer-devel:local .",

  // Mirrors what a consumer supplies, so the image can be smoke tested here.
  "containerEnv": {
    "RUNNER_ALLOW_RUNASROOT": "1",
    "ZEPHYR_BASE": "/workdir/zephyr-sdks/v4.4.0/zephyr",
    "ZEPHYR_SDK_INSTALL_DIR": "/workdir/zephyr-sdks/toolchains/zephyr-sdk-1.0.1",
    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
    "ZSDK_TOOLCHAINS": "arm-zephyr-eabi x86_64-zephyr-elf xtensa-espressif_esp32_zephyr-elf xtensa-espressif_esp32s3_zephyr-elf",
    "ZEPHYR_BLOBS": "hal_espressif"
  },

  "containerUser": "root",
  "remoteUser": "root",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--privileged"
  ],

  "mounts": [
    // Same shared volumes as consumers, so a test here warms the same cache.
    "source=zephyr-sdks,target=/workdir/zephyr-sdks,type=volume",
    "source=ncs-sdks,target=/workdir/ncs-sdks,type=volume",
    // CMake package registry -- the nRF Connect SDK picker reads it, and
    // setup-sdks.sh rewrites it too late for a fresh container to see it.
    "source=${localWorkspaceFolderBasename}-cmake-registry,target=/root/.cmake,type=volume",
    "source=/dev,target=/dev,type=bind,bind-propagation=rslave"
  ],

  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postStartCommand": "/opt/devcontainer/setup-sdks.sh"
}
